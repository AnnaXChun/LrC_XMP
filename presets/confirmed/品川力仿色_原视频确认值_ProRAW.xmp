      <crs:Name>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">品川力仿色｜原视频确认值（ProRAW）</rdf:li>
        </rdf:Alt>
      </crs:Name>
      <crs:Group>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">视频调色复现</rdf:li>
        </rdf:Alt>
      </crs:Group>
      <crs:Description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">根据 LeoCarbin摄影的品川力仿色视频读取原案例最终参数。包含固定曝光 +0.30、色温 5903、色调 +9 和 Adobe Color 配置文件，面向 RAW／ProRAW。未在 Lightroom 中实测。</rdf:li>
        </rdf:Alt>
      </crs:Description>
      <crs:ToneCurvePV2012>
        <rdf:Seq>
          <rdf:li>0, 30</rdf:li>
          <rdf:li>42, 53</rdf:li>
          <rdf:li>255, 217</rdf:li>
        </rdf:Seq>
