      <crs:Name><rdf:Alt><rdf:li xml:lang="x-default">柔光日常｜风格研究</rdf:li></rdf:Alt></crs:Name>
      <crs:Group><rdf:Alt><rdf:li xml:lang="x-default">LrC_XMP｜风格研究</rdf:li></rdf:Alt></crs:Group>
      <crs:Description><rdf:Alt><rdf:li xml:lang="x-default">抬高中间调与黑场，柔化高光，让植物和日常小物的颜色更轻。本项目试验数值，非摄影师原始配方；Lightroom 效果未实测。</rdf:li></rdf:Alt></crs:Description>
      <crs:ToneCurvePV2012><rdf:Seq>
        <rdf:li>0, 10</rdf:li>
        <rdf:li>64, 72</rdf:li>
        <rdf:li>128, 144</rdf:li>
        <rdf:li>192, 205</rdf:li>
        <rdf:li>255, 249</rdf:li>
      </rdf:Seq></crs:ToneCurvePV2012>
    </rdf:Description>
